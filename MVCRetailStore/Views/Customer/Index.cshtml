@model IEnumerable<MVCRetailStore.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}
<h1>Customers</h1>

<p><a class="btn btn-success" asp-action="Create">Create New</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.First().customerName)</th>
            <th>@Html.DisplayNameFor(m => m.First().customerEmail)</th>
            <th>Partition</th>
            <th>RowKey</th>
            <th>Last Updated</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.customerName</td>
                <td>@item.customerEmail</td>
                <td>@item.PartitionKey</td>
                <td>@item.RowKey</td>
                <td>@item.Timestamp</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-partitionKey="@item.PartitionKey" asp-route-rowKey="@item.RowKey">Details</a>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-partitionKey="@item.PartitionKey" asp-route-rowKey="@item.RowKey">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-partitionKey="@item.PartitionKey" asp-route-rowKey="@item.RowKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
